[Unit]
Description=QPX Volume Confirmation 25% Alpaca SIP Forward Paper Runner (simulated only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
Slice=qpx.slice
WorkingDirectory=/home/ron/QPX_ALPHA
Environment=QPX_PAPER_PROFILE=/home/ron/.local/lib/qpx-live-paper/current/qpx_bot/paper_profiles/volume_confirmation_25_v1.json
Environment=QPX_SHADOW_MATRIX_ENABLED=0
ExecStart=/usr/bin/python3 -u /home/ron/.local/lib/qpx-live-paper/current/QPX_RUN_VOLUME_CONFIRMATION_FORWARD_PAPER.py --daemon --poll-seconds 5 --runtime-dir /home/ron/QPX_ALPHA/runtime/qpx_volume_confirmation_25_alpaca_sip_forward_paper_clean_v3
Restart=on-failure
RestartSec=60
TimeoutStopSec=360
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
